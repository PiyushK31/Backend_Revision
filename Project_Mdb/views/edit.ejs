<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User - User Management</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen">
    <!-- Navigation Header -->
    <nav class="bg-white shadow-xl sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <h1 class="text-3xl font-bold bg-gradient-to-r from-indigo-600 to-blue-600 bg-clip-text text-transparent">
                User Management
            </h1>
            <a href="/read" class="bg-gradient-to-r from-indigo-600 to-blue-600 text-white font-bold py-2 px-6 rounded-lg hover:from-indigo-700 hover:to-blue-700 transition duration-200 transform hover:scale-105 shadow-lg">
                📖 Go Back
            </a>
        </div>
    </nav>
    <!-- Main Container -->
    <div class="max-w-2xl mx-auto px-6 py-12">
        <!-- Card Container -->
        <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
            <!-- Header Section -->
            <div class="bg-gradient-to-r from-indigo-600 to-blue-600 px-8 py-8">
                <h2 class="text-3xl font-bold text-white mb-2">Update User</h2>
                <p class="text-indigo-100">Update the user details below</p>
            </div>

            <!-- Form Section -->
            <div class="px-8 py-8">
                <form method="POST" action="/update/<%= user._id %>" class="space-y-6">
                    <!-- Name Input -->
                    <div class="relative">
                        <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
                            Full Name
                        </label>
                        <input 
                            type="text" 
                            id="name" 
                            name="name" 
                            value="<%= user.name %>"
                            placeholder="Enter your full name"
                            required
                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 transition duration-200 text-gray-700"
                        />
                    </div>

                    <!-- Email Input -->
                    <div class="relative">
                        <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
                            Email Address
                        </label>
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            value="<%= user.email %>"
                            placeholder="Enter your email address"
                            required
                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 transition duration-200 text-gray-700"
                        />
                    </div>

                    <!-- Image URL Input -->
                    <div class="relative">
                        <label for="imageurl" class="block text-sm font-semibold text-gray-700 mb-2">
                            Profile Image URL
                        </label>
                        <input 
                            type="url" 
                            id="imageurl" 
                            name="imageurl" 
                            value="<%= user.imageurl %>"
                            placeholder="https://example.com/image.jpg"
                            required
                            class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 transition duration-200 text-gray-700"
                        />
                    </div>

                    <!-- Image Preview -->
                    <div id="imagePreview">
                        <p class="text-sm font-semibold text-gray-700 mb-2">Image Preview</p>
                        <div class="flex justify-center">
                            <img id="previewImg" src="<%= user.imageurl %>" alt="Preview" class="w-32 h-32 rounded-lg object-cover border-2 border-indigo-300">
                        </div>
                    </div>

                    <!-- Button Group -->
                    <div class="flex gap-4 pt-6">
                        <button 
                            type="submit" 
                            class="flex-1 bg-gradient-to-r from-indigo-600 to-blue-600 text-white font-bold py-3 px-6 rounded-lg hover:from-indigo-700 hover:to-blue-700 transition duration-200 transform hover:scale-105 shadow-lg"
                        >
                            Update User
                        </button>
                        <a 
                            href="/read" 
                            class="flex-1 bg-gray-300 text-gray-700 font-bold py-3 px-6 rounded-lg hover:bg-gray-400 transition duration-200 transform hover:scale-105 text-center"
                        >
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Info Card -->
        <div class="mt-8 bg-white rounded-lg shadow-lg p-6">
            <h3 class="text-lg font-bold text-gray-800 mb-3">Requirements</h3>
            <ul class="space-y-2 text-gray-600">
                <li class="flex items-center">
                    <span class="text-indigo-600 mr-3">✓</span>
                    Name must be at least 2 characters
                </li>
                <li class="flex items-center">
                    <span class="text-indigo-600 mr-3">✓</span>
                    Valid email address is required
                </li>
                <li class="flex items-center">
                    <span class="text-indigo-600 mr-3">✓</span>
                    Valid image URL is required
                </li>
            </ul>
        </div>
    </div>

    <!-- JavaScript for Image Preview -->
    <script>
        const imageUrlInput = document.getElementById('imageurl');
        const previewImg = document.getElementById('previewImg');

        imageUrlInput.addEventListener('input', function() {
            if (this.value) {
                previewImg.src = this.value;
                previewImg.onerror = function() {
                    previewImg.src = 'https://via.placeholder.com/300x200?text=Invalid+Image';
                };
            }
        });
    </script>
</body>
</html>