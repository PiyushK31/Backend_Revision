<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users - User Management</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="bg-gray-100">

    <!-- Navbar -->
    <nav class="bg-white shadow-md">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">

            <h1 class="text-3xl font-bold text-indigo-600">
                User Management
            </h1>

            <a href="/"
               class="bg-indigo-600 text-white px-5 py-2 rounded hover:bg-indigo-700 transition">
                Create User
            </a>

        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-6 py-10">

        <h2 class="text-4xl font-bold mb-8">
            All Users
        </h2>

        <% if (users && users.length) { %>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

                <% users.forEach(user => { %>

                    <div class="bg-white rounded-lg shadow overflow-hidden">

                        <img
                            src="<%= user.imageurl || '/images/default-user.png' %>"
                            alt="User Image"
                            class="w-full h-52 object-cover"
                            onerror="this.onerror=null;this.src='/images/default-user.png';"
                        >

                        <div class="p-5">

                            <h3 class="text-xl font-bold">
                                <%= user.name %>
                            </h3>

                            <p class="text-gray-500 mt-2 break-all">
                                <%= user.email %>
                            </p>

                            <div class="mt-5 flex gap-3">

                                <a
                                    href="/edit/<%= user._id %>"
                                    class="flex-1 bg-blue-500 text-white text-center py-2 rounded hover:bg-blue-600">
                                    Edit
                                </a>

                                <a
                                    href="/delete/<%= user._id %>"
                                    onclick="return confirm('Delete this user?')"
                                    class="flex-1 bg-red-500 text-white text-center py-2 rounded hover:bg-red-600">
                                    Delete
                                </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <div class="text-center py-20">

                <h2 class="text-3xl font-bold">
                    No Users Found
                </h2>

                <p class="text-gray-500 mt-3">
                    Create your first user.
                </p>

                <a
                    href="/"
                    class="inline-block mt-6 bg-indigo-600 text-white px-6 py-3 rounded hover:bg-indigo-700">
                    Create User
                </a>

            </div>

        <% } %>

    </div>

</body>
</html>