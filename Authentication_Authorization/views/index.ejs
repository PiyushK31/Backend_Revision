<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>

    <div class="w-full h-screen bg-zinc-900">
        <h1 class="text-white p-2 rounded-md text-center text-3xl font-bold">CREATE USER</h1>
        <form method="post" action="/create" class="w-1/2 mx-auto mt-20">
            <div class="flex flex-col gap-3">
                <input type="text" name="username" placeholder="Username" class="p-2 rounded-md text-white bg-zinc-800">
                <input type="email" name="email" placeholder="Email" class="p-2 rounded-md text-white bg-zinc-800">
                <input type="password" name="password" placeholder="Password" class="p-2 rounded-md text-white bg-zinc-800">
                <input type="number" name="age" placeholder="Age" class="p-2 rounded-md text-white bg-zinc-800">
                <button type="submit" class="bg-blue-500 text-white p-2 rounded-md">Create User</button>
            </div>
        </form>
    </div>
</body>
</html>